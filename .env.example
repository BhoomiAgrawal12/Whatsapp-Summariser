# LLM provider: "openai" (recommended, ~pennies per summary) or "ollama" (free, local, weaker)
LLM_PROVIDER=openai

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (required when LLM_PROVIDER=ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Dashboard
DASHBOARD_PORT=8790
# 127.0.0.1 = this machine only. Set 0.0.0.0 to open it to your LAN
# (unauthenticated — only do this on a trusted home network).
DASHBOARD_HOST=127.0.0.1

# Where the SQLite DB + starred media live
DATA_DIR=./data

# Log level: trace|debug|info|warn|error
LOG_LEVEL=info
